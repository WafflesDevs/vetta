# Copy to .env and fill in. Never commit real keys.

OPENAI_API_KEY=
TAVILY_API_KEY=

# Jobs (free tier). Order: Adzuna → JSearch → Tavily. Apify off unless JOBS_USE_APIFY=true
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JSEARCH_API_KEY=
# RAPIDAPI_KEY=   # alias for JSEARCH_API_KEY
APIFY_API_KEY=
# JOBS_USE_APIFY=false
# JOBS_PROVIDER=adzuna

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=

# LangSmith (tracing)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=vetta

# production | development
ENV=development
ALLOWED_ORIGINS=*

# Optional knobs (defaults are fine)
# AGENT_MODEL=gpt-4o-mini
# JOBS_MAX_ITEMS=25
# JOBS_CACHE_TTL_SECONDS=3600
