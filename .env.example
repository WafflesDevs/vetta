# Copy to .env and fill in. Never commit real keys.
# .env is gitignored — only this example file is tracked.

ANTHROPIC_API_KEY=
TAVILY_API_KEY=

# Jobs providers. Order: Adzuna → JSearch → Tavily. Apify off unless JOBS_USE_APIFY=true
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JSEARCH_API_KEY=
# RAPIDAPI_KEY=   # alias for JSEARCH_API_KEY
APIFY_API_KEY=
JOBS_USE_APIFY=false
# JOBS_PROVIDER=adzuna

SUPABASE_URL=
SUPABASE_ANON_KEY=
# Secret key (sb_secret_…) or legacy service_role JWT — needed for admin profile writes.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=  # alias if SUPABASE_SECRET_KEY is empty

# Password reset email redirect (allowlist in Supabase Auth → URL config).
# Local: http://localhost:5173/reset-password
# If unset, the API uses the browser Origin + /reset-password.
PASSWORD_RESET_REDIRECT_URL=http://localhost:5173/reset-password

# Signup email confirmation redirect (allowlist the same way).
# Local: http://localhost:5173/confirm-email
EMAIL_CONFIRM_REDIRECT_URL=http://localhost:5173/confirm-email

# Public app origin (used if/when billing returns)
APP_URL=http://localhost:5173

# Stripe — paid plans are TBA; billing routes return 503. Keys optional / unused for now.
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# VITE_STRIPE_PUBLISHABLE_KEY=
# STRIPE_PRODUCT_EXPERT=
# STRIPE_PRODUCT_PRO=
# STRIPE_PRICE_EXPERT=
# STRIPE_PRICE_PRO=
# STRIPE_WEBHOOK_SECRET=

# LangSmith (tracing)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=vetta

# production | development
ENV=development
ALLOWED_ORIGINS=*

# --- Product limits (defaults match current free/TBA product) ---
# Chat: 2 open chats, 30 messages each — delete a chat to continue
MAX_CHATS=2
MAX_MESSAGES_PER_CHAT=30

# Jobs: capped for cost; force-refresh once per hour
JOBS_MAX_ITEMS=10
JOBS_CACHE_TTL_SECONDS=3600
JOBS_REFRESH_COOLDOWN_SECONDS=3600
# JOBS_MATCH_CACHE_TTL_SECONDS=21600
# JOBS_MATCH_SCORE_MAX=25

# Quiz: 2 cycles per rolling hour
QUIZ_MAX_CYCLES_PER_HOUR=2
QUIZ_CYCLE_WINDOW_SECONDS=3600
QUIZ_QUESTIONS_PER_CYCLE=5
# Optional remote JSON bank (same shape as app/data/interview_questions.json)
# QUIZ_BANK_URL=

# Public /try funnel (anonymous; bank-only quiz — no LLM)
# PUBLIC_TRY_QUESTIONS=4
# PUBLIC_TRY_QUIZ_PER_HOUR=10
# PUBLIC_TRY_RESULTS_PER_HOUR=20
# PUBLIC_TRY_RESUME_MAX_BYTES=1000000

# Optional model knobs
# AGENT_MODEL=claude-sonnet-4-5
# RESUME_EDIT_MODEL=claude-sonnet-4-5
# MATCH_SCORE_MODEL=claude-haiku-4-5
