# Copy to .env and fill in. Never commit real keys.

ANTHROPIC_API_KEY=
TAVILY_API_KEY=

# Jobs (free tier). Order: Adzuna → JSearch → Tavily. Apify off unless JOBS_USE_APIFY=true
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JSEARCH_API_KEY=
# RAPIDAPI_KEY=   # alias for JSEARCH_API_KEY
APIFY_API_KEY=
# JOBS_USE_APIFY=false
# JOBS_PROVIDER=adzuna

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=

# Password reset email redirect (must be allowlisted in Supabase Auth → URL config).
# Local default: http://localhost:5173/reset-password
# If unset, the API uses the browser Origin + /reset-password.
PASSWORD_RESET_REDIRECT_URL=http://localhost:5173/reset-password

# Stripe (test or live keys — never commit real values)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=

# LangSmith (tracing)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=vetta

# production | development
ENV=development
ALLOWED_ORIGINS=*

# Optional knobs (defaults are fine)
# AGENT_MODEL=claude-sonnet-4-5
# RESUME_EDIT_MODEL=claude-sonnet-4-5
# MATCH_SCORE_MODEL=claude-haiku-4-5
# MAX_CHATS=1
# MAX_MESSAGES_PER_CHAT=60
# JOBS_MAX_ITEMS=200
# JOBS_MAX_ITEMS_FREE=5
# JOBS_MAX_ITEMS_EXPERT=120
# JOBS_MAX_ITEMS_PRO=200
# JOBS_CACHE_TTL_SECONDS=3600
# JOBS_CACHE_TTL_FREE_SECONDS=21600
# JOBS_CACHE_TTL_PAID_SECONDS=1800
# JOBS_REFRESH_COOLDOWN_FREE_SECONDS=3600
# JOBS_MATCH_CACHE_TTL_SECONDS=21600
# JOBS_MATCH_SCORE_MAX=25
# QUIZ_MAX_CYCLES_FREE=1
# QUIZ_QUESTIONS_PER_CYCLE=5
# Optional remote JSON bank (same shape as app/data/interview_questions.json). No key needed for public URLs.
# QUIZ_BANK_URL=
# Public /try funnel (anonymous; bank-only quiz, heuristic resume — no LLM)
# PUBLIC_TRY_QUESTIONS=4
# PUBLIC_TRY_QUIZ_PER_HOUR=10
# PUBLIC_TRY_RESULTS_PER_HOUR=20
# PUBLIC_TRY_RESUME_MAX_BYTES=1000000
